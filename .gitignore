gnome-shell-js/
mutter-src/
src-mutter/
src-shell/

# 上游源码压缩包 (gnome-shell-50.6.tar.xz、mutter-50.6.tar.xz)，
# 仅在需要重新解压参考源码时使用，不纳入版本库
tarballs/

# ZCode 会话内部文件
.zcode/

# 静态分析工具虚拟环境
.venv-shexli/
