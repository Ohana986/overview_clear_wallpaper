# 测试脚本在项目根目录生成的隔离会话与截图 (.test-home、.test-home-perf 等)
.test-home*/

# 编译产物
gschemas.compiled
*.mo

# 上架打包产物
.build/
dist/
*.shell-extension.zip

# Python / Node 临时文件
__pycache__/
*.py[cod]
node_modules/

# 编辑器与系统文件
*~
*.swp
.DS_Store
.vscode/
.idea/

# 上游参考源码：解析 GNOME Shell / Mutter 源码包得到，供查阅实现，
